<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
        <add value="Default.htm" />
        <add value="iisstart.htm" />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".mp3" />
      <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
      <!-- The shipped tree seals every voice clip and hero painting: 66 `.mp3.enc`
           and no plain `.mp3`. IIS answers 404.3 for an extension it does not map,
           and tea-seal.ts reads a 404 as a missing file and falls silent, so
           without this line the drop-in has no voice at all. -->
      <remove fileExtension=".enc" />
      <mimeMap fileExtension=".enc" mimeType="application/octet-stream" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src &apos;self&apos;; script-src &apos;self&apos; &apos;wasm-unsafe-eval&apos;; worker-src &apos;self&apos; blob:; style-src &apos;self&apos;; img-src &apos;self&apos; data: blob:; media-src &apos;self&apos; blob:; font-src &apos;self&apos;; connect-src &apos;self&apos; https://open.er-api.com https://api.frankfurter.dev https://api.open-meteo.com https://get.geojs.io https://ipwho.is https://en.wikipedia.org https://zh.wikipedia.org https://ja.wikipedia.org; object-src &apos;none&apos;; base-uri &apos;self&apos;; form-action &apos;self&apos;; frame-ancestors &apos;self&apos;" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), display-capture=(), idle-detection=(), xr-spatial-tracking=(), local-fonts=()" />
        <remove name="Cross-Origin-Opener-Policy" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <remove name="Cross-Origin-Resource-Policy" />
        <add name="Cross-Origin-Resource-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <!--
    The hashed build output, and only the hashed build output, is cached for a
    year. IIS sends no Cache-Control of its own, so on this host the bundle that
    the Node server marks `public, max-age=31536000, immutable` was revalidated
    on every visit. The rule is scoped to `assets/` on purpose: a <clientCache>
    at the root would pin `index.html` for a year as well, and no deploy would
    ever be seen again.
  -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="immutable" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
