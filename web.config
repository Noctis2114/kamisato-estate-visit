<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
        <add value="Default.htm" />
        <add value="iisstart.htm" />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".mp3" />
      <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src &apos;self&apos;; script-src &apos;self&apos;; worker-src &apos;self&apos; blob:; style-src &apos;self&apos;; img-src &apos;self&apos; data: blob:; media-src &apos;self&apos; blob:; font-src &apos;self&apos;; connect-src &apos;self&apos; https://open.er-api.com https://api.frankfurter.app https://api.open-meteo.com https://get.geojs.io https://ipwho.is; object-src &apos;none&apos;; base-uri &apos;self&apos;; form-action &apos;self&apos;; frame-ancestors &apos;self&apos;" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
